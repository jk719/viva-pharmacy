# Application Configuration
NODE_ENV=development
DEBUG=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERCEL_URL=localhost:3000

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Authentication & Security
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key
JWT_SECRET=your-jwt-secret-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Analytics & Tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your-ga-api-secret
GA_DEBUG_MODE=true

# Media Storage
## Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=viva_pharmacy_products
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=viva-pharmacy/products

## AWS S3 Configuration
S3_BUCKET_DOMAIN=vivapharmacy.s3.amazonaws.com
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Payment Processing (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_default_price_id

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_TEMPLATE_ID_WELCOME=d-template-id
EMAIL_TEMPLATE_ID_ORDER=d-template-id

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
TWILIO_VERIFY_SERVICE_ID=your-verify-service-id

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# External Services
RXNORM_API_KEY=your-rxnorm-api-key
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST

# Rate Limiting & Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
IP_WHITELIST=127.0.0.1,::1

# Loyalty Program
LOYALTY_POINTS_MULTIPLIER=1
LOYALTY_MINIMUM_POINTS_REDEMPTION=100
LOYALTY_POINTS_EXPIRY_DAYS=365
LOYALTY_WELCOME_BONUS=100

# Feature Flags
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_PRESCRIPTION_UPLOAD=true

# Development Settings
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_API_MOCKING=false
NEXT_PUBLIC_DEBUG_ANALYTICS=true

# Note: Replace all placeholder values with your actual configuration
# Never commit real credentials to version control
# For development, copy this file to .env.local and update values 