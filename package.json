{
  "name": "viva-pharmacy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "build:debug": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "build:trace": "NEXT_TRACE=1 next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && mv .next/standalone docs && git add . && git commit -m 'Deploy to GitHub Pages' && git push origin main",
    "cleanup-orders": "node -r dotenv/config scripts/cleanupDuplicateOrders.mjs",
    "test:email": "node test-email.mjs",
    "test:email:to": "node test-email.mjs",
    "clean": "rm -rf .next && rm -rf node_modules/.cache && npm install",
    "clean:hard": "rm -rf .next node_modules package-lock.json && npm cache clean --force && npm install",
    "update-stock": "node scripts/updateProductStock.mjs",
    "cache:clear": "rm -rf .next/cache",
    "dev:turbo": "NEXT_TURBO=1 next dev",
    "analyze": "ANALYZE=true next build",
    "typecheck": "tsc --noEmit",
    "enhance-products": "node scripts/enhanceProducts.mjs",
    "verify-products": "node scripts/verifyProducts.mjs",
    "check-cloudinary": "node scripts/checkCloudinaryImages.js",
    "fix-cloudinary": "node scripts/fixCloudinaryMapping.js",
    "verify-cloudinary": "node scripts/verifyCloudinaryUrls.js",
    "map-cloudinary": "node scripts/mapCloudinaryImages.js",
    "fix-images": "node scripts/fixProductImages.js",
    "apply-mappings": "node scripts/applyImageMappings.js",
    "prepare-uploads": "node scripts/prepareImageUploads.js",
    "upload-images": "node scripts/uploadMissingImages.js",
    "list-images": "node scripts/listCloudinaryImages.js",
    "update-products": "node scripts/updateProductImages.js",
    "migrate:cloudinary": "node --experimental-modules scripts/migrateToCloudinary.js",
    "list:cloudinary": "node scripts/listCloudinaryUrls.js",
    "update:cloudinary": "node scripts/updateProductsWithCloudinaryUrls.js",
    "list:missing": "node scripts/listMissingImages.js",
    "sync:cloudinary": "node scripts/syncCloudinaryToMongo.js",
    "list:all-cloudinary": "node scripts/listAllCloudinaryResources.js",
    "test:integration": "jest --config jest.config.js --testMatch \"**/__tests__/integration/**/*.test.js\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate:loyalty": "node scripts/migrateLoyaltySchema.mjs",
    "dev:mobile": "next dev -H 0.0.0.0 -p 3001",
    "migrate:images": "node scripts/migrate-product-images.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@google-cloud/storage": "^7.15.2",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@mui/x-data-grid": "^7.27.3",
    "@react-email/components": "^0.0.34",
    "@react-email/render": "^1.0.5",
    "@react-email/tailwind": "^1.0.4",
    "@react-pdf/renderer": "^4.3.0",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.2.0",
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.4.8",
    "cloudinary": "^2.6.0",
    "critters": "^0.0.23",
    "cropperjs": "^2.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "firebase": "^11.5.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.0",
    "lru-cache": "^11.0.2",
    "mitt": "^3.0.1",
    "mongoose": "^8.10.0",
    "next": "^15.1.3",
    "next-auth": "^4.24.10",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-easy-crop": "^5.4.1",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.7",
    "react-intersection-observer": "^9.15.1",
    "react-places-autocomplete": "^7.3.0",
    "react-spinners": "^0.15.0",
    "recharts": "^2.15.1",
    "resend": "^4.1.2",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^17.4.0",
    "swr": "^2.3.0",
    "twilio": "^5.5.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "eslint-plugin-react": "^7.37.3",
    "globals": "^15.14.0",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.14"
  },
  "resolutions": {
    "@types/react": "19.0.8"
  }
}
