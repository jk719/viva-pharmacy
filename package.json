{
  "name": "viva-pharmacy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:debug": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "build:trace": "NEXT_TRACE=1 next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && mv .next/standalone docs && git add . && git commit -m 'Deploy to GitHub Pages' && git push origin main",
    "cleanup-orders": "node -r dotenv/config scripts/cleanupDuplicateOrders.js",
    "test:email": "node test-email.mjs",
    "test:email:to": "node test-email.mjs",
    "clean": "rm -rf .next node_modules/.cache",
    "update-stock": "node scripts/updateProductStock.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.2.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "mitt": "^3.0.1",
    "mongoose": "^8.8.1",
    "next": "^15.1.3",
    "next-auth": "^4.24.10",
    "nodemailer": "^6.9.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.4.0",
    "react-intersection-observer": "^9.15.1",
    "react-places-autocomplete": "^7.3.0",
    "stripe": "^17.4.0",
    "swr": "^2.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "eslint-plugin-react": "^7.37.3",
    "globals": "^15.14.0",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.14"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
